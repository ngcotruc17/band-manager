# Cấu hình máy chủ Backend v2
PORT=5000
NODE_ENV=development

# Kết nối MongoDB (Atlas hoặc Local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/band-manager

# Bảo mật JWT
JWT_SECRET=your_super_secret_jwt_key_here

# Khóa bí mật webhook ngân hàng (SePay / Cassso)
WEBHOOK_SECRET=your_bank_webhook_secret_key

# Danh sách Origin được phép truy cập CORS (phân tách bởi dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://sacband.vercel.app

# URL frontend phục vụ đính kèm link trong email thông báo
FRONTEND_URL=http://localhost:3000

# Cấu hình gửi email tự động (Nodemailer / Gmail App Password)
EMAIL_USER=band.sac.music@gmail.com
EMAIL_PASS=your_gmail_app_password
